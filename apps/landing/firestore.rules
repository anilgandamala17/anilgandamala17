rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student profiles — users can only read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public lead capture (qualification modals) — create only
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['type', 'name', 'email', 'organization', 'createdAt'])
        && request.resource.data.type in ['schools', 'professionals']
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow read, update, delete: if false;
    }

    // Contact / demo form — create only
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.message is string;
      allow read, update, delete: if false;
    }

    // Waitlist / coming-soon — create only
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Curriculum teaching content — read for authenticated users; writes via Admin SDK only
    match /curriculumTopics/{topicId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /teachingContent/{docId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /segments/{segmentId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /contentGenerationJobs/{jobId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
